<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/tv_accent</item>
        <item name="android:colorPrimary">@color/tv_surface_raised</item>
        <item name="android:colorPrimaryDark">@color/tv_background</item>
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:textColorPrimary">@color/tv_text_primary</item>
        <item name="android:textColorSecondary">@color/tv_text_secondary</item>
        <item name="android:buttonStyle">@style/TvButtonStyle</item>
        <item name="android:alertDialogTheme">@style/TvDialogTheme</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="TvButtonStyle" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_action_button</item>
        <item name="android:textColor">@color/tv_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/tv_button_min_height</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">@dimen/tv_body_type</item>
        <item name="android:paddingStart">@dimen/tv_space_2</item>
        <item name="android:paddingEnd">@dimen/tv_space_2</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="TvDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/tv_accent</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/tv_text_primary</item>
        <item name="android:textColorSecondary">@color/tv_text_secondary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:buttonBarButtonStyle">@style/TvButtonStyle</item>
    </style>
</resources>
