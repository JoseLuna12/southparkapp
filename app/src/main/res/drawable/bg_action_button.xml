<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_disabled_surface" />
            <stroke android:width="1dp" android:color="@color/tv_outline" />
            <corners android:radius="@dimen/tv_button_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_accent_pressed" />
            <stroke android:width="2dp" android:color="@color/tv_text_primary" />
            <corners android:radius="@dimen/tv_button_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_accent" />
            <stroke android:width="2dp" android:color="@color/tv_text_primary" />
            <corners android:radius="@dimen/tv_button_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_surface_raised" />
            <stroke android:width="1dp" android:color="@color/tv_outline" />
            <corners android:radius="@dimen/tv_button_radius" />
        </shape>
    </item>
</selector>
