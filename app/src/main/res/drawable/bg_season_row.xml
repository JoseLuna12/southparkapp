<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_surface_selected" />
                    <corners android:radius="@dimen/tv_rail_radius" />
                </shape>
            </item>
            <item android:width="3dp" android:gravity="start">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_accent" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_surface_raised" />
            <corners android:radius="@dimen/tv_rail_radius" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
